# Cấu hình Server HTTP
PORT=5000
NODE_ENV=development

# Cấu hình Kết nối MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_home

# Cấu hình MQTT Broker
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_CLIENT_ID=backend_smarthome_node_server
MQTT_USERNAME=
MQTT_PASSWORD=

# Chế độ MOCK (true: giả lập sensor & ESP8266 khi không có phần cứng | false: kết nối MQTT thực tế)
MOCK_MODE=true

# Secret Token JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
